import datetime, random

def multi_select(options, title):
    print(f"\n{title}")
    print("Select MULTIPLE. Example: 1,3")
    for i, opt in enumerate(options, 1):
        print(f"{i}. {opt}")
    raw = input("Type numbers: ")
    selected = []
    for x in raw.split(","):
        x = x.strip()
        if x.isdigit() and 1 <= int(x) <= len(options):
            selected.append(options[int(x)-1])
    if not selected:
        selected = [options[0]]
    print(f"You selected: {selected}")
    return selected

def single_select(options, title):
    print(f"\n{title}")
    for i, opt in enumerate(options, 1):
        print(f"{i}. {opt}")
    raw = input("Type number: ").strip()
    if raw.isdigit() and 1 <= int(raw) <= len(options):
        return options[int(raw)-1]
    return options[0]

